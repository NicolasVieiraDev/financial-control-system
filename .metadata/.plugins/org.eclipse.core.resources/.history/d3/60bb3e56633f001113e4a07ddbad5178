package br.com.nicolasvieira.financialcontrol.model;

import java.math.BigDecimal;
import java.time.LocalDate;
import java.util.UUID;

import br.com.nicolasvieira.financialcontrol.exceptions.BusinessException;

public class Expense {
	
	private UUID id;
	private String description;
	private BigDecimal value;
	private LocalDate date;
	private Category category;
	private ExpenseType type;
	
	public Expense(String description, BigDecimal value, LocalDate date, Category category, ExpenseType type) {
		if (description == null || description.trim().isEmpty()) {
			throw new BusinessException("The description cannot be empty.");
		}
		if (value == null || value.compareTo(BigDecimal.ZERO) <= 0) {
			throw new BusinessException("The value must be greater than zero.");
		}
		if (date == null) {
			throw new BusinessException("The date cannot be null.");
		}
		if (category == null) {
			throw new BusinessException("The category cannot be null.");
		}
		if (type == null) {
			throw new BusinessException("The type cannot be null.");
		}
		
		this.id = UUID.randomUUID();
		this.description = description.trim();
		this.value = value;
		this.date = date;
		this.category = category;
		this.type = type;
	}

	public UUID getId() {
		return id;
	}

	public String getDescription() {
		return description;
	}

	public BigDecimal getValue() {
		return value;
	}

	public LocalDate getDate() {
		return date;
	}

	public Category getCategory() {
		return category;
	}

	public ExpenseType getType() {
		return type;
	}
}
